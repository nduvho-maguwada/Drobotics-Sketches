const int pins[] = {2, 3, 4, 5, 6, 7};
void setup() {
  for(int i=0; i<6; i++) pinMode(pins[i], OUTPUT);
}

void step(int sA, int iA, int sB, int iB, int sC, int iC) {
  digitalWrite(2, sA); 
  digitalWrite(3, iA);
  digitalWrite(4, sB); 
  digitalWrite(5, iB);
  digitalWrite(6, sC); 
  digitalWrite(7, iC);
  delayMicroseconds(400) 
}

void loop() {
  //   SD_A, IN_A, SD_B, IN_B, SD_C, IN_C
  step(HIGH, HIGH,  HIGH, LOW,   LOW,  LOW);  // A+ B-
  step(HIGH, HIGH,  LOW,  LOW,   HIGH, LOW);  // A+ C-
  step(LOW,  LOW,   HIGH, HIGH,  HIGH, LOW);  // B+ C-
  step(HIGH, LOW,   HIGH, HIGH,  LOW,  LOW);  // B+ A-
  step(HIGH, LOW,   LOW,  LOW,   HIGH, HIGH); // C+ A-
  step(LOW,  LOW,   HIGH, LOW,   HIGH, HIGH); // C+ B-
}
