const int SD_pinA = 1;
const int IN_pinA = 2;
const int SD_pinB = 3;
const int IN_pinB = 4;
const int SD_pinC = 5;
const int IN_pinC = 6;

void setup() {
  pinMode(SD_pinA, OUTPUT);
  pinMode(IN_pinA,  OUTPUT);
  pinMode(SD_pinB, OUTPUT);
  pinMode(IN_pinB,  OUTPUT);
  pinMode(SD_pinC, OUTPUT);
  pinMode(IN_pinC,  OUTPUT);
}
                                                                                                          
void loop() {
  // A - B
digitalWrite(SD_pinA, HIGH);
digitalWrite(IN_pinA, HIGH);

digitalWrite(SD_pinB, HIGH);
digitalWrite(IN_pinB, LOW);

digitalWrite(SD_pinC, LOW);
digitalWrite(IN_pinC, LOW);
delay(0.4);

// A - C
digitalWrite(SD_pinA, HIGH);
digitalWrite(IN_pinA, HIGH);

digitalWrite(SD_pinC, HIGH);
digitalWrite(IN_pinC, LOW);

digitalWrite(SD_pinB, LOW);
digitalWrite(IN_pinB, LOW);

delay(0.4);

// B - C
digitalWrite(SD_pinB, HIGH);
digitalWrite(IN_pinB, HIGH);

digitalWrite(SD_pinC, HIGH);
digitalWrite(IN_pinC, LOW);

digitalWrite(SD_pinA, LOW);
digitalWrite(IN_pinA, LOW);

delay(0.4);

// B - A
digitalWrite(SD_pinB, HIGH);
digitalWrite(IN_pinB, HIGH);

digitalWrite(SD_pinA, HIGH);
digitalWrite(IN_pinA, LOW);

digitalWrite(SD_pinC, LOW);
digitalWrite(IN_pinC, LOW);

delay(0.4);

//C - A
digitalWrite(SD_pinC, HIGH);
digitalWrite(IN_pinC, HIGH);

digitalWrite(SD_pinA, HIGH);
digitalWrite(IN_pinA, LOW);

digitalWrite(SD_pinB, LOW);
digitalWrite(IN_pinB, LOW);
delay(0.4);

//C - B
digitalWrite(SD_pinC, HIGH);
digitalWrite(IN_pinC, HIGH);

digitalWrite(SD_pinB, HIGH);
digitalWrite(IN_pinB, LOW);

digitalWrite(SD_pinA, LOW);
digitalWrite(IN_pinA, LOW);
delay(0.4);
}
