#include <WiFi.h>
#include <esp_now.h>
#include <ESP32Servo.h>

Servo esc;

const int escPin = 0;

typedef struct {
  int throttle;
} ControlData;

ControlData incomingData;

// ESC signal range
const int minPulse = 1000;  // idle
const int maxPulse = 2000;  // full throttle

void onDataRecv(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  memcpy(&incomingData, data, sizeof(incomingData));
}

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW Init Failed");
    return;
  }

  esp_now_register_recv_cb(onDataRecv);

  esc.attach(escPin, minPulse, maxPulse);

  // ARM ESC (IMPORTANT ⚠️)
  Serial.println("Arming ESC...");
  esc.writeMicroseconds(1000); // minimum throttle
  delay(3000);
}

void loop() {
  int throttle = incomingData.throttle;

  // Map joystick (0–4095) → ESC (1000–2000)
  int escSignal = map(throttle, 0, 4095, minPulse, maxPulse);

  // Safety clamp
  escSignal = constrain(escSignal, minPulse, maxPulse);

  esc.writeMicroseconds(escSignal);

  Serial.print("ESC Signal: ");
  Serial.println(escSignal);

  delay(20);
}
