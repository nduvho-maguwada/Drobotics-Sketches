#include <WiFi.h>
#include <esp_now.h>

// Receiver MAC
uint8_t receiverMAC[] = {0xA8, 0x46, 0x74, 0x46, 0x16, 0x24};

typedef struct {
  int throttle;
} ControlData;

ControlData data;

esp_now_peer_info_t peerInfo;

// Joystick pins
const int joyY = 35;  // throttle

// Deadzone
const int deadzone = 50;

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW Init Failed");
    return;
  }

  memcpy(peerInfo.peer_addr, receiverMAC, 6);
  peerInfo.channel = 0;
  peerInfo.encrypt = false;

  esp_now_add_peer(&peerInfo);
}

void loop() {
  int yValue = analogRead(joyY);

  // Apply deadzone around center (approx 2048)
  if (abs(yValue - 2048) < deadzone) {
    yValue = 2048;
  }

  data.throttle = yValue;

  esp_now_send(receiverMAC, (uint8_t *)&data, sizeof(data));

  Serial.print("Throttle: ");
  Serial.println(yValue);

  delay(50);
}
