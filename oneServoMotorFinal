#include <esp_now.h>
#include <WiFi.h>
#include <ESP32Servo.h>
#include <esp_wifi.h> // Required for channel hacking

const int SERVO_PIN = 18; 
Servo myServo;
int currentAngle = 90; 

typedef struct struct_message {
    int command;
    int speed;
} struct_message;

struct_message incomingData;

// Track packet counts for visual debugging
unsigned long packetCount = 0;

void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingDataRaw, int len) {
  packetCount++;
  
  // Flash an alert to the serial monitor that ANY packet arrived
  Serial.print("--- PACKET #");
  Serial.print(packetCount);
  Serial.println(" RECEIVED! ---");

  // Print sender MAC address
  char macStr[18];
  snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
           info->src_addr[0], info->src_addr[1], info->src_addr[2], 
           info->src_addr[3], info->src_addr[4], info->src_addr[5]);
  Serial.print("From Sender MAC: ");
  Serial.println(macStr);

  memcpy(&incomingData, incomingDataRaw, sizeof(incomingData));
  
  if (incomingData.command == 1) currentAngle -= incomingData.speed; 
  if (incomingData.command == 2) currentAngle += incomingData.speed; 

  currentAngle = constrain(currentAngle, 0, 180);
  myServo.write(currentAngle);

  Serial.print("Data -> Cmd: ");
  Serial.print(incomingData.command);
  Serial.print(" | Speed: ");
  Serial.print(incomingData.speed);
  Serial.print(" | Servo Angle: ");
  Serial.println(currentAngle);
  Serial.println("---------------------------");
}

void setup() {
  Serial.begin(115200);
  delay(1000); // Give serial monitor time to open

  Serial.println("\n==================================");
  Serial.println("ESP32-S3 DEBUG RECEIVER STARTING");
  Serial.println("==================================");

  // 1. Force state print of your exact MAC address
  WiFi.mode(WIFI_STA);
  Serial.print("[CRITICAL] Actual Receiver MAC: ");
  Serial.println(WiFi.macAddress());

  // 2. FORCE CHANNEL MATCHING (Fixes 90% of S3 vs Wemos delivery failures)
  // ESP32-S3 and Wemos D1 R32 MUST be on the exact same channel. We lock both to Channel 1.
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);
  
  uint8_t primaryChan;
  wifi_second_chan_t secondChan;
  esp_wifi_get_channel(&primaryChan, &secondChan);
  Serial.print("Locked Radio to Wi-Fi Channel: ");
  Serial.println(primaryChan);

  // Servo Setup
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  myServo.setPeriodHertz(50); 
  myServo.attach(SERVO_PIN, 500, 2400); 
  myServo.write(currentAngle); 

  // Initialize ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("[-] Error initializing ESP-NOW");
    return;
  }
  Serial.println("[+] ESP-NOW Initialized successfully.");
  
  esp_now_register_recv_cb(OnDataRecv);
  Serial.println("[+] Receiver Callback Registered. Ready & listening...");
}

void loop() {
  // Simple heartbeat to prove the ESP32-S3 code hasn't frozen
  static unsigned long lastHeartbeat = 0;
  if (millis() - lastHeartbeat > 3000) {
    lastHeartbeat = millis();
    Serial.print("Listening... Total packets received so far: ");
    Serial.println(packetCount);
  }
}
