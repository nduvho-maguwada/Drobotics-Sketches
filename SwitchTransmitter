#include <WiFi.h>
#include <esp_now.h>


const int btnForward = 26;
const int btnReverse = 27;


uint8_t receiverMAC[] = {0x44, 0x1D, 0x64, 0xF5, 0x82, 0xB4};

struct Switch {
  int command;
};

Switch outgoing;
int lastCommand = -1;

void setup() {
  Serial.begin(115200);

  pinMode(btnForward, INPUT_PULLUP);
  pinMode(btnReverse, INPUT_PULLUP);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed");
    return;
  }

  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, receiverMAC, 6);
  peerInfo.channel = 0;
  peerInfo.encrypt = false;

  esp_now_add_peer(&peerInfo);
}

void loop() {

  bool forwardPressed = (digitalRead(btnForward) == LOW);
  bool reversePressed = (digitalRead(btnReverse) == LOW);

  if (forwardPressed && !reversePressed) {
    outgoing.command = 1; 
  }
  else if (reversePressed && !forwardPressed) {
    outgoing.command = 2; 
  }
  else {
    outgoing.command = 0; 
  }

  if (outgoing.command != lastCommand) {

    esp_now_send(receiverMAC, (uint8_t*) &outgoing, sizeof(outgoing));

    Serial.print("Sent: ");
    Serial.println(outgoing.command);

    lastCommand = outgoing.command;
  }

  delay(50);
}
