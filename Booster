// --- Pin Definitions (ESP32 Specific) ---
const int pwmPin = 13;          // GPIO13 - Gate Drive
const int voltageSensePin = 36; // GPIO36 (ADC1_CH0) - Voltage Divider
const int enablePin = 15;       // GPIO15 - Optional enable switch (HIGH = on)

// --- Boost Converter Parameters ---
const float targetVoltage = 14.4;   // Target charging voltage
const float maxVoltage = 14.7;      // Absolute max voltage (safety shutdown)

// --- PWM Configuration (New LEDC API) ---
const int pwmFrequency = 62500;     // 62.5 kHz switching frequency
const int pwmResolution = 10;       // 10-bit resolution (0-1023)

// --- PID Controller Gains ---
float Kp = 0.5;    
float Ki = 0.05;   
float Kd = 0.01;   

// --- PID Variables ---
float integral = 0;
float lastError = 0;
unsigned long lastTime = 0;

// --- Voltage Sensing Configuration ---
// Ratio = R2 / (R1 + R2) | e.g., R1=100k, R2=18k -> 0.1525
const float voltageDividerRatio = 0.1525; 

// --- Timing Variables ---
unsigned long lastBlink = 0;
const unsigned long serialInterval = 1000;

// ==========================================
//  SETUP FUNCTION
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(100); 
  
  Serial.println("\n=====================================");
  Serial.println("ESP32 Boost Converter - Updated API");
  Serial.println("=====================================");
  
  pinMode(enablePin, INPUT_PULLUP);
  analogReadResolution(12); 
  
  // --- Initialize LEDC PWM (New v3.0+ Method) ---
  // This replaces ledcSetup and ledcAttachPin
  ledcAttach(pwmPin, pwmFrequency, pwmResolution);
  
  // Start with 0% duty cycle (Safety First)
  ledcWrite(pwmPin, 0);
  
  Serial.print("PWM Active on GPIO ");
  Serial.println(pwmPin);
}

// ==========================================
//  READ OUTPUT VOLTAGE
// ==========================================
float readOutputVoltage() {
  int adcValue = analogRead(voltageSensePin);
  float voltageAtDivider = adcValue * (3.3 / 4095.0);
  return voltageAtDivider / voltageDividerRatio;
}

// ==========================================
//  SET PWM DUTY CYCLE (0-100%)
// ==========================================
void setPWMDutyCycle(int dutyPercent) {
  // Cap at 95% to prevent the inductor from saturating or MOSFET overheating
  dutyPercent = constrain(dutyPercent, 0, 95);
  
  int maxDuty = (1 << pwmResolution) - 1; 
  int dutyValue = (dutyPercent * maxDuty) / 100;
  
  // New API: Write directly to the pin
  ledcWrite(pwmPin, dutyValue);
}

// ==========================================
//  PID CONTROL ALGORITHM
// ==========================================
float computePID(float setpoint, float input) {
  unsigned long now = millis();
  float timeChange = (float)(now - lastTime) / 1000.0;
  
  if (timeChange <= 0) timeChange = 0.01;

  float error = setpoint - input;
  float proportional = Kp * error;
  
  integral += Ki * error * timeChange;
  integral = constrain(integral, -50, 50); // Anti-windup
  
  float derivative = Kd * (error - lastError) / timeChange;
  float output = proportional + integral + derivative;
  
  lastError = error;
  lastTime = now;
  
  return output;
}

// ==========================================
//  MAIN LOOP
// ==========================================
void loop() {
  bool enabled = digitalRead(enablePin);
  
  if (!enabled) {
    setPWMDutyCycle(0);
    integral = 0;
    lastError = 0;
    if (millis() - lastBlink > 2000) {
      lastBlink = millis();
      Serial.println("System DISABLED via Pin 15");
    }
    return;
  }

  float actualVoltage = readOutputVoltage();
  
  // Compute PID and adjust duty cycle
  float pidOutput = computePID(targetVoltage, actualVoltage);
  int dutyCycle = 50 + (int)pidOutput; 
  dutyCycle = constrain(dutyCycle, 5, 95);
  
  setPWMDutyCycle(dutyCycle);

  // Serial Monitor Updates
  if (millis() - lastBlink > 1000) {
    lastBlink = millis();
    Serial.printf("V_Out: %.2fV | Duty: %d%% | Target: %.2fV\n", actualVoltage, dutyCycle, targetVoltage);
  }

  // Safety Shutdown
  if (actualVoltage > maxVoltage) {
    setPWMDutyCycle(0);
    Serial.println("!!! OVERVOLTAGE PROTECTION ACTUATED !!!");
    delay(2000); 
  }
  
  delay(50); // Loop frequency ~20Hz
}
